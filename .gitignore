# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Jupyter Notebooks
.ipynb_checkpoints/
*.ipynb

# Output and logs
output/
monitor/output/
*.log
logs/

# Credentials and Environment files
.env
.env.*
credentials.txt
legacy/credentials.txt
scraper/credentials.txt
config/credentials.json
database/credentials.json
config/config-live.ini
config/config-paper.ini
config/config.ini

*.key
*.pem
*.p12
**/credentials/
**/.credentials/

# installation_files directory (contains large files and credentials)
installation_files/

# Database backups and runtime databases
sqlite_backup_*.csv
database_backup_*.sql
*.db
*.db-journal
*.db-shm
*.db-wal

# Airflow
airflow_project/airflow.db
airflow_project/airflow.db-*
airflow_project/logs/
airflow_project/airflow-webserver.pid

# IBC Gateway - config files with credentials
ibc-setup/config/config-live.ini
ibc-setup/config/config-paper.ini

# IBC Gateway - ALL runtime files and logs
ibc-setup/logs/
ibc-setup/tws/*/launcher.log
ibc-setup/tws/*/COLDRESTART*

# IBC Gateway - TWS settings directories (contain session data and credentials)
ibc-setup/tws/live-settings/**
ibc-setup/tws/paper-settings/**

# Allow template files
!ibc-setup/config/*.template
!ibc-setup/tws/live-settings/.gitkeep
!ibc-setup/tws/paper-settings/.gitkeep
